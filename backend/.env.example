# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/wastewallet?retryWrites=true&w=majority&appName=Cluster0

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
